# Flatpak manifest scaffold. UNVERIFIED: it has not been built (needs
# flatpak-builder) and Flathub submission is the maintainer's to make.
# It repackages the release's Linux tarball, which already holds the app and
# the bundled daemon in bin/.
app-id: io.github.sabadia.dlm
runtime: org.gnome.Platform
runtime-version: "48"
sdk: org.gnome.Sdk
command: dlm_app
finish-args:
  - --share=ipc
  - --share=network
  - --socket=fallback-x11
  - --socket=wayland
  - --device=dri
  - --filesystem=xdg-download
  - --talk-name=org.kde.StatusNotifierWatcher
  - --talk-name=org.freedesktop.Notifications
  - --talk-name=org.freedesktop.secrets
modules:
  - name: dlm
    buildsystem: simple
    build-commands:
      - mkdir -p /app/lib/dlm /app/bin
      - cp -r ./* /app/lib/dlm/
      - ln -s /app/lib/dlm/dlm_app /app/bin/dlm_app
      - install -Dm644 io.github.sabadia.dlm.desktop /app/share/applications/io.github.sabadia.dlm.desktop
      - install -Dm644 io.github.sabadia.dlm.metainfo.xml /app/share/metainfo/io.github.sabadia.dlm.metainfo.xml
    sources:
      - type: archive
        url: https://github.com/sabadia/dlm-app/releases/download/v@VERSION@/DLM_@VERSION@_linux_x64.tar.gz
        sha256: @SHA256@
      # Both files are in packaging/linux; the metainfo has @VERSION@ and
      # @DATE@ filled in first, as tools/package_linux.sh does.
      - type: file
        path: ../linux/io.github.sabadia.dlm.desktop
      - type: file
        path: io.github.sabadia.dlm.metainfo.xml
